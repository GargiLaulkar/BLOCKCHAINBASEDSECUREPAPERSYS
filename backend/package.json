{
  "name": "@sigil/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src test scripts --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:authorization-matrix": "vitest run test/authorization-matrix.test.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts && openapi-typescript ../docs/api/openapi.json -o ../frontend/src/api/generated.ts",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code -- ../docs/api/openapi.json ../frontend/src/api/generated.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "@sigil/contracts-types": "workspace:*",
    "@sigil/core": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "siwe": "^3.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.4"
  }
}
