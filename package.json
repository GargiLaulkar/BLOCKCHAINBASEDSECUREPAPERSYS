{
  "name": "sigil-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "description": "Time-locked, threshold-controlled custody of examination papers on a blockchain ledger",
  "scripts": {
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev:chain": "pnpm --filter @sigil/contracts hardhat node",
    "dev:api": "pnpm --filter @sigil/backend dev",
    "dev:web": "pnpm --filter @sigil/frontend dev",
    "dev:all": "node scripts/dev-all.mjs",
    "demo:bootstrap-roles": "pnpm --filter @sigil/contracts hardhat demo:bootstrap-roles --network localhost",
    "demo:reset": "node scripts/demo-reset.mjs",
    "test:auth-matrix": "node scripts/test-auth-matrix.mjs",
    "coverage": "pnpm --filter @sigil/contracts coverage",
    "coverage:check": "pnpm --filter @sigil/contracts coverage:check",
    "docs:contract": "pnpm --filter @sigil/contracts docs:contract",
    "test:contracts": "pnpm --filter @sigil/contracts test",
    "coverage:contracts": "pnpm --filter @sigil/contracts coverage",
    "lint:contracts": "pnpm --filter @sigil/contracts lint"
  }
}
